# 자격증명 템플릿. 이 파일을 `.env` 로 복사해서 값을 채운다 — `.env` 는 .gitignore 대상이다.
#
# 🔑 레포가 PUBLIC 이다. 여기에 실제로 쓰는 값을 적지 마라.
#    2026-09-12 에 부하 실측용 compose 파일에 값이 박혀 그대로 공개된 전례가 있다.
#
# 읽는 곳:
#   docker-compose.bridge.yml            (레포 루트에서 실행 → compose 가 .env 를 자동으로 읽는다)
#   infra/aws/deploy.sh                  (읽어서 ssh 로 인라인 전달. rsync 로는 올리지 않는다)
#   infra/aws/{app,worker,data}.yml      (deploy.sh 가 넘긴 값을 받는다)
#
# ⚠️ DB_PASSWORD 는 한 값이 두 곳에서 쓰인다 — MySQL 이 계정을 만들 때(data.yml 의
#    MYSQL_PASSWORD)와 앱이 접속할 때(app/worker 의 DB_PASSWORD)다. 일부러 같은 변수로
#    묶어 뒀다. 따로 두면 어긋나도 기동은 되고 접속만 실패해서 원인 찾기가 어렵다.

# MySQL root. 스키마 적재와 헬스체크가 쓴다.
MYSQL_ROOT_PASSWORD=

# 앱 계정(queueapp). MySQL 계정 생성 + 앱 접속에 같이 쓰인다.
DB_PASSWORD=

# prod 프로필이 요구한다. 32바이트 이상이어야 한다.
#   생성: openssl rand -base64 48
JWT_SECRET_CURRENT=

# 부하 실측 전용 — 테넌트 rate limit 오버라이드 (미설정이면 코드 상수 50,000 / 833.34).
# 🪤 둘을 같이 줘라. capacity = refill × 60 을 지키지 않으면 버킷 TTL 이 1시간으로 튄다.
# 🔑 올린 판은 앱 기동 로그에 WARN 으로 남는다 — 그게 실제 값의 정본이다.
#RL_TENANT_CAPACITY=3000000
#RL_TENANT_REFILL=50000

# Alertmanager → Slack. 없으면 알람은 Alertmanager 까지만 모이고 사람에게는 안 간다.
#   만드는 곳: Slack → Apps → Incoming Webhooks → Add to Workspace → 채널 선택
#   🔴 이 값은 **URL 자체가 비밀번호다**. 레포에 적지 마라 — deploy.sh 가 노드에 파일로 쓴다.
SLACK_WEBHOOK_URL=
